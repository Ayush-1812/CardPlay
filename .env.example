# Generate .env with `node scripts/setup.mjs`. Never commit real credentials.
APP_ENV=development
HTTP_ADDR=:8080
APP_ORIGIN=http://localhost:3000
POSTGRES_USER=cardplay
POSTGRES_DB=cardplay
POSTGRES_PASSWORD=
DATABASE_URL=
SEED_PASSWORD=
SMTP_ADDR=localhost:1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=hello@cardplay.test
API_INTERNAL_URL=http://127.0.0.1:8080
# Voice chat (docs/14-voice-chat.md). Without a TURN server voice still
# works on ordinary home networks; a strict one needs the relay.
VOICE_ENABLED=1
VOICE_STUN_URLS=stun:stun.l.google.com:19302
VOICE_TURN_URLS=
VOICE_TURN_SECRET=
VOICE_TURN_TTL=10m

# Operations (docs/10-operations.md)
LOG_FORMAT=
LOG_LEVEL=info
# Private interface only; /metrics is unauthenticated.
METRICS_ADDR=
DB_MAX_CONNS=20

# Server moves for a player idle this long (0 = off).
MATCH_TURN_TIMEOUT=2m
