# Generate .env with `node scripts/setup.mjs`. Never commit real credentials.
APP_ENV=development
HTTP_ADDR=:8080
APP_ORIGIN=http://localhost:3000
POSTGRES_USER=cardplay
POSTGRES_DB=cardplay
POSTGRES_PASSWORD=
DATABASE_URL=
SEED_PASSWORD=
SMTP_ADDR=localhost:1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=hello@cardplay.test
API_INTERNAL_URL=http://127.0.0.1:8080
# Operations (docs/10-operations.md)
LOG_FORMAT=
LOG_LEVEL=info
# Private interface only; /metrics is unauthenticated.
METRICS_ADDR=
DB_MAX_CONNS=20

# Server moves for a player idle this long (0 = off).
MATCH_TURN_TIMEOUT=2m
