# Settings for compose.prod.yaml. Copy to .env.prod and fill in.
# Keep .env.prod out of version control; it holds real credentials.

# The public address, without scheme. Caddy gets a certificate for exactly
# this name, and the API accepts writes and sockets only from it.
SITE_ADDRESS=yourname.duckdns.org
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# Database. Use letters and digits only: the password goes into a URL.
POSTGRES_USER=cardplay
POSTGRES_DB=cardplay
POSTGRES_PASSWORD=changemeToSomethingLong

# Mail for verification and password recovery. Any transactional provider.
SMTP_ADDR=smtp.provider.com:587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=CardPlay <hello@example.com>

# How long a player may think before the table plays for them; 0 turns it off.
MATCH_TURN_TIMEOUT=2m
