# One public origin for the whole site. Caddy obtains and renews the TLS
# certificate itself and passes everything, including WebSocket upgrades, to
# the Next.js client, which proxies /api and /ws on to the API.
{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy web:3000
}
